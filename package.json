{
  "name": "@acedatacloud/n8n-nodes-face-transform",
  "version": "0.1.1",
  "description": "Analyze and transform faces in n8n through the Ace Data Cloud Face Transform service.",
  "license": "MIT",
  "homepage": "https://github.com/AceDataCloud/FaceTransformN8N",
  "keywords": ["n8n-community-node-package", "acedatacloud", "face-transform", "face-analysis", "image"],
  "author": {
    "name": "Ace Data Cloud",
    "email": "dev@acedata.cloud",
    "url": "https://platform.acedata.cloud"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AceDataCloud/FaceTransformN8N.git"
  },
  "bugs": { "url": "https://github.com/AceDataCloud/FaceTransformN8N/issues" },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "test": "node --test tests/*.test.cjs",
    "prepublishOnly": "npm run build && npm run lint && npm test"
  },
  "files": ["dist/credentials", "dist/nodes", "examples"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": ["dist/credentials/AceDataFaceTransformApi.credentials.js"],
    "nodes": ["dist/nodes/FaceTransform/FaceTransform.node.js"]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.51.2",
    "typescript": "5.9.3",
    "prettier": "3.6.2",
    "eslint": "9.29.0"
  },
  "peerDependencies": { "n8n-workflow": "*" },
  "publishConfig": { "access": "public", "provenance": true }
}
